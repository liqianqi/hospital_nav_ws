<?xml version="1.0"?>
<package format="3">
  <name>omni_nav_bringup</name>
  <version>0.1.0</version>
  <description>Point-LIO mapping/odometry, FFT+GICP relocalization and Nav2 bringup for the omni robot in the hospital sim</description>
  <maintainer email="ncstcrt1024@gmail.com">ubuntu</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>pcl_conversions</depend>
  <depend>libpcl-all-dev</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>point_lio</exec_depend>
  <exec_depend>gicp_relocalization</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
